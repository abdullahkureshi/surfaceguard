# Copy the names below into your host's secret settings (Fly: `fly secrets set NAME=value`).
# Never commit real values.

ENVIRONMENT=production
BASE_URL=https://surfaceguard.fly.dev
SESSION_SECRET=                     # long random string, e.g. python -c "import secrets;print(secrets.token_hex(32))"

# Stripe (Dashboard -> Developers). Use sk_test_ first, switch to sk_live_ when you launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=              # whsec_... from the webhook endpoint you create
STRIPE_PRICE_PRO=                   # price_... for the €29/month Pro price
STRIPE_PRICE_MSP=                   # price_... for the €149/month MSP price

# Alert emails (any SMTP provider: Postmark, Resend, Brevo, Mailgun...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@yourdomain.com

# Optional
DATA_DIR=/data
CLIENT_IP_HEADER=Fly-Client-IP
MAX_CONCURRENT_SCANS=4
